{
    "version": 1,
    "project": "pgmpy-dev",
    "project_url": "https://pgmpy.org/",
    "repo": "https://github.com/pgmpy/pgmpy.git",
    "dvcs": "git",
    "branches": ["dev"],
    "environment_type": "virtualenv",
    "pythons": ["3.14"],
    "matrix": {"req": {"pip+asv_runner": ["0.3.2"]}},
    "build_command": ["python -mpip wheel --no-deps -w {build_cache_dir} {build_dir}"],
    "uninstall_command": ["return-code=any python -mpip uninstall -y pgmpy"],
    "benchmark_dir": "benchmarks",
    "launch_method": "forkserver",
    "env_dir": ".asv/env",
    "results_dir": "results",
    "html_dir": "html"
}
